{
  "openapi": "3.0.3",
  "info": {
    "title": "HilmiAdinko API",
    "version": "1.0.0",
    "description": "REST API for the HilmiAdinko portfolio, contact, kategori layanan, and testimoni management system.\n\nDibuat oleh **Ahmad Hilmi Fahrezi**.",
    "contact": {
      "name": "Ahmad Hilmi Fahrezi"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Manage user data"
    },
    {
      "name": "Home",
      "description": "Home page data"
    },
    {
      "name": "About",
      "description": "About page data"
    },
    {
      "name": "Layanan",
      "description": "Layanan (services) data"
    },
    {
      "name": "Portofolio",
      "description": "Simple portofolio read (legacy GET only)"
    },
    {
      "name": "Portfolio",
      "description": "Manage portfolio projects (full CRUD)"
    },
    {
      "name": "Testimoni",
      "description": "Simple testimoni read (legacy GET only)"
    },
    {
      "name": "TestimoniCRUD",
      "description": "Manage client testimonials (full CRUD)"
    },
    {
      "name": "Kontak",
      "description": "Kontak page data (legacy GET only)"
    },
    {
      "name": "Contact",
      "description": "Manage contact submissions (full CRUD)"
    },
    {
      "name": "Kategori",
      "description": "Manage service categories - kategori layanan (full CRUD)"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get all users",
        "operationId": "getAllUsers",
        "responses": {
          "200": {
            "description": "List of users retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User Data has been retrieved"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a new user",
        "operationId": "createNewUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "New User has been created"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserInput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - name and email required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Data requirement not fulfilled, please fill name and email"
                    },
                    "data": {
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
