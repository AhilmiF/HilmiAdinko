    "title": "HilmiAdinko API",
    "version": "1.0.0",
    "description": "REST API for the HilmiAdinko portfolio, contact, kategori layanan, and testimoni management system.\n\nDibuat oleh **Ahmad Hilmi Fahrezi**.",
    "contact": {
      "name": "Ahmad Hilmi Fahrezi"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Portfolio",
      "description": "Manage portfolio projects"
    },
    {
      "name": "Kategori",
      "description": "Manage service categories (kategori layanan)"
    },
    {
      "name": "Contact",
      "description": "Manage contact submissions"
    },
    {
      "name": "Testimoni",
      "description": "Manage client testimonials"
    }
