  "components": {
    "schemas": {
      "Portfolio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nama_proyek": {
            "type": "string",
            "example": "Renovasi Gedung A"
          },
          "lokasi": {
            "type": "string",
            "example": "Jakarta Selatan"
          },
          "kategori": {
            "type": "integer",
            "example": 2,
            "description": "FK ke idkategori_layanan"
          },
          "kategori_layanan": {
            "type": "string",
            "example": "Renovasi",
            "description": "Nama kategori (dari JOIN)"
          },
          "tahun": {
            "type": "integer",
            "example": 2024
          },
          "deskripsi": {
            "type": "string",
            "example": "Proyek renovasi gedung perkantoran 3 lantai"
          },
          "image_url": {
            "type": "string",
            "example": "http://localhost:4000/assets/gedung-a.jpg"
          }
        }
      },
      "PortfolioInput": {
        "type": "object",
        "required": [
          "nama_proyek",
          "lokasi",
          "kategori",
          "tahun",
          "deskripsi",
          "image_url"
        ],
        "properties": {
          "nama_proyek": {
            "type": "string",
            "example": "Renovasi Gedung A"
          },
          "lokasi": {
            "type": "string",
            "example": "Jakarta Selatan"
          },
          "kategori": {
            "type": "integer",
            "example": 2,
            "description": "ID kategori layanan"
          },
          "tahun": {
            "type": "integer",
            "example": 2024
          },
          "deskripsi": {
            "type": "string",
            "example": "Proyek renovasi gedung perkantoran 3 lantai"
          },
          "image_url": {
            "type": "string",
            "example": "http://localhost:4000/assets/gedung-a.jpg"
          }
        }
      },
      "Kategori": {
        "type": "object",
        "properties": {
          "idkategori_layanan": {
            "type": "integer",
            "example": 1
          },
          "kategori_layanan": {
            "type": "string",
            "example": "Pembangunan"
          }
        }
      },
      "KategoriInput": {
        "type": "object",
        "required": [
          "kategori_layanan"
        ],
        "properties": {
          "kategori_layanan": {
            "type": "string",
            "example": "Pembangunan"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nama_lengkap": {
            "type": "string",
            "example": "Siti Rahma"
          },
          "no_whatsapp": {
            "type": "string",
            "example": "081234567890"
          },
          "lokasi": {
            "type": "string",
            "example": "Bandung"
          },
          "keterangan": {
            "type": "string",
            "example": "Ingin konsultasi pembangunan rumah"
          },
          "kategori": {
            "type": "integer",
            "example": 1,
            "description": "FK ke idkategori_layanan"
          },
          "kategori_layanan": {
            "type": "string",
            "example": "Pembangunan",
            "description": "Nama kategori (dari JOIN)"
          }
        }
      },
      "ContactInput": {
        "type": "object",
        "required": [
          "nama_lengkap",
          "no_whatsapp",
          "lokasi",
          "keterangan",
          "kategori"
        ],
        "properties": {
          "nama_lengkap": {
            "type": "string",
            "example": "Siti Rahma"
          },
          "no_whatsapp": {
            "type": "string",
            "example": "081234567890"
          },
          "lokasi": {
            "type": "string",
            "example": "Bandung"
          },
          "keterangan": {
            "type": "string",
            "example": "Ingin konsultasi pembangunan rumah"
          },
          "kategori": {
            "type": "integer",
            "example": 1,
            "description": "ID kategori layanan"
          }
        }
      },
      "Testimoni": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nama_klien": {
            "type": "string",
            "example": "Budi Santoso"
          },
          "waktu": {
            "type": "string",
            "format": "date",
            "example": "2024-01-15"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "deskripsi": {
            "type": "string",
            "example": "Pelayanan sangat memuaskan dan profesional."
          }
        }
      },
      "TestimoniInput": {
        "type": "object",
        "required": [
          "nama_klien",
          "waktu",
          "rating",
          "deskripsi"
        ],
        "properties": {
          "nama_klien": {
            "type": "string",
            "example": "Budi Santoso"
          },
          "waktu": {
            "type": "string",
            "format": "date",
            "example": "2024-01-15"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "deskripsi": {
            "type": "string",
            "example": "Pelayanan sangat memuaskan dan profesional."
          }
        }
      }
    },
    "responses": {
      "ServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Server Error"
                },
                "serverMessage": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}